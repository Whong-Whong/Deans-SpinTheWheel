generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model SpinWheelRegistration {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fullName  String
  school    String
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("spin_the_wheel_entries")
}

model PrizeConfig {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  prizeName   String
  maxWins     Int    @default(1)
  currentWins Int    @default(0)
  isEternal   Boolean @default(false)
  updatedAt   DateTime @updatedAt

  @@map("prize_config")
  @@unique([prizeName])
}
