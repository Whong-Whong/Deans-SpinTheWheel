generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model SpinWheelRegistration {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fullName  String
  school    String
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("spin_the_wheel_entries")
}
